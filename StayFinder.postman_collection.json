{
  "info": {
    "name": "StayFinder",
    "description": "Local StayFinder API examples. Set testEmail and testPassword in a local Postman environment; they are intentionally not defined or exported here. Postman cookie jar handles the session from login. Collection Runner skips all writes unless allowWrites=true; DELETE also requires allowDestructive=true. Use only disposable records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = pm.request.method.toUpperCase();",
          "const url = pm.request.url.toString();",
          "const authSessionRequest = method === \"POST\" && /\\/auth\\/(login|logout)\\/?(?:[?#].*)?$/.test(url);",
          "if (method === \"DELETE\" && (pm.collectionVariables.get(\"allowWrites\") !== \"true\" || pm.collectionVariables.get(\"allowDestructive\") !== \"true\")) {",
          "  console.warn(\"Skipped destructive request. Set allowWrites=true and allowDestructive=true only for an approved disposable record.\");",
          "  pm.execution.skipRequest();",
          "} else if ([\"POST\", \"PATCH\", \"PUT\"].includes(method) && !authSessionRequest && pm.collectionVariables.get(\"allowWrites\") !== \"true\") {",
          "  console.warn(\"Skipped write request. Set allowWrites=true only for an approved disposable record.\");",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
